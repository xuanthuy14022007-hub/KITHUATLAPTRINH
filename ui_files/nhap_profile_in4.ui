  <property name="styleSheet">
   <string notr="true">QWidget#NhapProfileInfoScreen {
    background-color: #F9FDF6;
}

QLabel {
    font-family: 'Segoe UI', Arial, sans-serif;
    color: #1F2B20;
}

QLineEdit {
    background-color: #FFFFFF;
    border: 1px solid #A0A0A0;
    border-radius: 10px;
    padding: 0px 15px;
    font-size: 11pt;
    font-family: 'Segoe UI', Arial, sans-serif;
    color: #1C1C1C;
    height: 48px;
}

QLineEdit:focus {
    border: 2px solid #3E7B40;
}

/* Style cho nút chọn Role (Nông dân / Chủ vựa) */
QRadioButton {
    background-color: #FFFFFF;
    border: 1px solid #A0A0A0;
    border-radius: 10px;
    padding-left: 15px;
    font-size: 12pt;
    font-family: 'Segoe UI', Arial, sans-serif;
    font-weight: bold;
    color: #1F2B20;
    min-height: 48px;
    max-height: 48px;
}
QRadioButton:hover {
    border: 1px solid #3E7B40;
}
QRadioButton:checked {
    border: 2px solid #3E7B40;
}
QRadioButton::indicator {
    width: 18px;
    height: 18px;
    border: 2px solid #1C1C1C;
    border-radius: 3px;
    background: none;
    margin-right: 10px;
}
QRadioButton::indicator:checked {
    background-color: #3E7B40;
    border: 2px solid #3E7B40;
}</string>
