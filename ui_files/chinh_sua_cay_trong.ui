  </property>
  <property name="windowTitle">
   <string>Thêm/Sửa/Xoá Cây Trồng</string>
  </property>
  <property name="styleSheet">
   <string notr="true">QWidget#ChinhSuaCayTrongPopup {
    background-color: #FAFAEE; /* Màu vàng siêu nhạt giống ảnh */
}
QLabel, QLineEdit, QTextEdit, QPushButton, QComboBox {
    font-family: 'Segoe UI', Arial, sans-serif;
}</string>
  </property>
  <layout class="QVBoxLayout" name="main_layout">
   <property name="spacing">
    <number>15</number>
   </property>
   <property name="leftMargin">
    <number>25</number>
   </property>
   <property name="topMargin">
    <number>25</number>
   </property>
   <property name="rightMargin">
    <number>25</number>
   </property>
   <property name="bottomMargin">
    <number>25</number>
   </property>

   <!-- HEADER: Tiêu đề và nút tắt -->
   <item>
    <layout class="QHBoxLayout" name="hbox_header">
     <item>
      <widget class="QLabel" name="lbl_title">
       <property name="styleSheet">
        <string notr="true">color: #2F4020; font-size: 16pt; font-weight: 900;</string>
       </property>
       <property name="text">
        <string>Thêm/Sửa/Xoá Cây Trồng</string>
       </property>
      </widget>
     </item>
     <item>
      <spacer name="hs_header">
       <property name="orientation"><enum>Qt::Horizontal</enum></property>
       <property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property>
      </spacer>
     </item>
     <item>
      <widget class="QPushButton" name="btn_close">
       <property name="minimumSize"><size><width>35</width><height>35</height></size></property>
       <property name="maximumSize"><size><width>35</width><height>35</height></size></property>
       <property name="cursor"><cursorShape>PointingHandCursor</cursorShape></property>
       <property name="styleSheet">
        <string notr="true">QPushButton {
    background-color: #FAFAEE;
    color: #E89595;
    border: 2px solid #F4B8B8;
    border-radius: 6px;
    font-size: 14pt;
    font-weight: bold;
}
QPushButton:hover { background-color: #F8E5E5; }</string>
       </property>
       <property name="text"><string>✖</string></property>
      </widget>
     </item>
    </layout>
   </item>

